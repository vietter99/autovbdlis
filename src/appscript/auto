function doPost(e) {
  try {
    var data = JSON.parse(e.postData.contents);
    var ss = SpreadsheetApp.getActiveSpreadsheet();

    if (data.bucket === 'sodiachinh') {
      return handleSoDiaChinh(ss, data);
    }
    if (data.bucket === 'thechap') {
      return handleTheChap(ss, data);
    }
    if (data.bucket === 'thongbao') {
      return handleThongBao(ss, data);
    }
    // 4 xã + Khác: ghi vào tab riêng, ĐỒNG THỜI ghi thêm vào tab "Tổng hợp" để tìm hồ sơ ở 1 chỗ.
    var result = handleXaTable(ss, data);
    handleTongHop(ss, data);
    return result;
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: String(err) }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// Chống trùng phía server: kiểm tra xem đã có dòng nào (trong khoảng startRow..lastRow) mà TẤT
// CẢ các cột trong "checks" đều khớp giá trị chưa. Cần thiết vì check chống trùng chính hiện tại
// nằm ở phía trình duyệt (localStorage) - nếu mất localStorage hoặc đổi máy/trình duyệt thì client
// không còn nhớ hồ sơ đã đẩy, dẫn tới ghi trùng dòng trên Sheet. checks: [{col, value}, ...].
function isDuplicateRow(sheet, checks, startRow, lastRow) {
  if (lastRow < startRow) return false;
  var cols = checks.map(function (c) { return c.col; });
  var minCol = Math.min.apply(null, cols);
  var maxCol = Math.max.apply(null, cols);
  var values = sheet.getRange(startRow, minCol, lastRow - startRow + 1, maxCol - minCol + 1).getValues();
  for (var i = 0; i < values.length; i++) {
    var isMatch = checks.every(function (c) {
      var cellVal = String(values[i][c.col - minCol] || '').trim().toUpperCase();
      var checkVal = String(c.value || '').trim().toUpperCase();
      return cellVal === checkVal;
    });
    if (isMatch) return true;
  }
  return false;
}

// Ghi vào 1 trong 5 tab theo xã (Krông Năng / Phú Xuân / Tam Giang / Dliê Ya / Khác)
function handleXaTable(ss, data) {
  var TAB_NAMES = {
    krongnang: 'Krông Năng',
    phuxuan: 'Phú Xuân',
    tamgiang: 'Tam Giang',
    dlieya: 'Dliê Ya',
    khac: 'Khác'
  };

  var tabName = TAB_NAMES[data.bucket];
  if (!tabName) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: 'Unknown bucket: ' + data.bucket }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var sheet = ss.getSheetByName(tabName);
  if (!sheet) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: 'Sheet not found: ' + tabName }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  // Tìm dòng trống kế tiếp dựa theo cột C (Tên TTHC), KHÔNG dùng getLastRow()
  // vì cột B có công thức kéo sẵn xuống nhiều dòng, sẽ làm getLastRow() trả về sai.
  var colC = sheet.getRange('C:C').getValues();
  var lastRow = colC.length;
  while (lastRow > 0 && colC[lastRow - 1][0] === '') lastRow--;

  // Chống trùng: GCN (cột G) + Thửa (cột H) + Tờ (cột I) đã có sẵn trên Sheet thì bỏ qua.
  if (data.gcn && isDuplicateRow(sheet, [
    { col: 7, value: data.gcn }, { col: 8, value: data.thua }, { col: 9, value: data.to }
  ], 7, lastRow)) {
    return ContentService.createTextOutput(JSON.stringify({ ok: true, skipped: true, reason: 'Trùng GCN/Thửa/Tờ' }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var targetRow = lastRow + 1;
  if (targetRow < 7) targetRow = 7; // dữ liệu bắt đầu từ dòng 7

  // Ghi từ cột C (Tên TTHC) đến cột O (HNK)
  sheet.getRange(targetRow, 3, 1, 13).setValues([[
    data.tenTTHC || '', data.maHS || '', data.hoTen || '', data.xa || '',
    data.gcn || '', data.thua || '', data.to || '', data.dienTich || '',
    data.datO || '', data.cln || '', data.lua || '', data.nts || '', data.hnk || ''
  ]]);

  return ContentService.createTextOutput(JSON.stringify({ ok: true, row: targetRow }))
    .setMimeType(ContentService.MimeType.JSON);
}

// Ghi thêm vào tab "Tổng hợp" - gộp cả 4 tab xã lại 1 chỗ để dễ tìm hồ sơ, cấu trúc cột
// giống hệt các tab xã (dữ liệu từ dòng 7, cột C->O). Không thay thế việc ghi vào tab xã
// riêng ở handleXaTable, đây là ghi THÊM. Nuốt lỗi nếu tab chưa tồn tại để không làm hỏng
// request chính (handleXaTable) đang chạy trước đó.
function handleTongHop(ss, data) {
  try {
    var sheet = ss.getSheetByName('Tổng hợp');
    if (!sheet) return;

    var colC = sheet.getRange('C:C').getValues();
    var lastRow = colC.length;
    while (lastRow > 0 && colC[lastRow - 1][0] === '') lastRow--;

    if (data.gcn && isDuplicateRow(sheet, [
      { col: 7, value: data.gcn }, { col: 8, value: data.thua }, { col: 9, value: data.to }
    ], 7, lastRow)) {
      return;
    }

    var targetRow = lastRow + 1;
    if (targetRow < 7) targetRow = 7;

    sheet.getRange(targetRow, 3, 1, 13).setValues([[
      data.tenTTHC || '', data.maHS || '', data.hoTen || '', data.xa || '',
      data.gcn || '', data.thua || '', data.to || '', data.dienTich || '',
      data.datO || '', data.cln || '', data.lua || '', data.nts || '', data.hnk || ''
    ]]);
  } catch (e) { }
}

// Ghi vào tab "Sổ địa chính" (sổ cấp GCN)
function handleSoDiaChinh(ss, data) {
  var sheet = ss.getSheetByName('Sổ địa chính');
  if (!sheet) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: 'Sheet not found: Sổ địa chính' }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  // Tìm dòng trống kế tiếp dựa theo cột B (Tên người được cấp), tương tự lý do ở trên
  var colB = sheet.getRange('B:B').getValues();
  var lastRow = colB.length;
  while (lastRow > 0 && colB[lastRow - 1][0] === '') lastRow--;

  // Chống trùng: Số phát hành (cột C) là định danh duy nhất của 1 GCN.
  if (data.soPhatHanh && isDuplicateRow(sheet, [
    { col: 3, value: data.soPhatHanh }
  ], 13, lastRow)) {
    return ContentService.createTextOutput(JSON.stringify({ ok: true, skipped: true, reason: 'Trùng Số phát hành' }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var targetRow = lastRow + 1;
  if (targetRow < 13) targetRow = 13; // dữ liệu bắt đầu từ dòng 13

  // Ghi cột B (Tên người được cấp), C (Số phát hành), D (Ngày ký GCN)
  sheet.getRange(targetRow, 2, 1, 3).setValues([[
    data.nguoiDuocCap || '', data.soPhatHanh || '', data.ngayKyGCN || ''
  ]]);
  // Cột G (Xã) - không liền với B:D nên ghi riêng
  sheet.getRange(targetRow, 7, 1, 1).setValue(data.xa || '');

  return ContentService.createTextOutput(JSON.stringify({ ok: true, row: targetRow }))
    .setMimeType(ContentService.MimeType.JSON);
}

// Ghi vào tab "Thế chấp" (chỉ 1 dòng tiêu đề, dữ liệu bắt đầu từ dòng 2)
function handleTheChap(ss, data) {
  var sheet = ss.getSheetByName('Thế chấp');
  if (!sheet) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: 'Sheet not found: Thế chấp' }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  // Tìm dòng trống kế tiếp dựa theo cột C (Mã hồ sơ)
  var colC = sheet.getRange('C:C').getValues();
  var lastRow = colC.length;
  while (lastRow > 0 && colC[lastRow - 1][0] === '') lastRow--;

  // Chống trùng: GCN (cột F) + Thửa (cột G) + Tờ (cột H) đã có sẵn trên Sheet thì bỏ qua.
  if (data.gcn && isDuplicateRow(sheet, [
    { col: 6, value: data.gcn }, { col: 7, value: data.thua }, { col: 8, value: data.to }
  ], 2, lastRow)) {
    return ContentService.createTextOutput(JSON.stringify({ ok: true, skipped: true, reason: 'Trùng GCN/Thửa/Tờ' }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var targetRow = lastRow + 1;
  if (targetRow < 2) targetRow = 2; // dữ liệu bắt đầu từ dòng 2

  // Cột A (STT) KHÔNG ghi từ script - dùng công thức kéo sẵn trong Sheet (giống bảng "của tôi"),
  // tự gộp STT cho các dòng cùng Mã hồ sơ. Ghi từ cột B (Loại HS) đến cột P (Ngày).
  sheet.getRange(targetRow, 2, 1, 15).setValues([[
    data.loaiHS || '', data.maHS || '', data.hoTen || '', data.diaChi || '',
    data.gcn || '', data.thua || '', data.to || '', data.dienTich || '',
    data.datO || '', data.cln || '', data.tsn || '', data.lua || '', data.hnk || '',
    data.skc || '', data.ngay || ''
    // Cột Q (Giờ hẹn trả) cố tình bỏ trống - ghi tay
  ]]);

  return ContentService.createTextOutput(JSON.stringify({ ok: true, row: targetRow }))
    .setMimeType(ContentService.MimeType.JSON);
}

// Ghi vào tab "Thông báo nhận HS" (chỉ 1 dòng tiêu đề, dữ liệu bắt đầu từ dòng 2). Cột E
// (Trạng thái) KHÔNG ghi từ script - dùng công thức tra cột Mã HS ở tab "Tổng hợp" để tự biết
// đã giải quyết hay chưa (không liên quan Thế chấp/Xác nhận).
function handleThongBao(ss, data) {
  var sheet = ss.getSheetByName('Thông báo nhận HS');
  if (!sheet) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: 'Sheet not found: Thông báo nhận HS' }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  // Tìm dòng trống kế tiếp dựa theo cột A (Mã hồ sơ)
  var colA = sheet.getRange('A:A').getValues();
  var lastRow = colA.length;
  while (lastRow > 0 && colA[lastRow - 1][0] === '') lastRow--;

  // Chống trùng: Mã hồ sơ (cột A) đã có sẵn thì bỏ qua (1 hồ sơ chỉ nhận thông báo 1 lần).
  if (data.maHS && isDuplicateRow(sheet, [
    { col: 1, value: data.maHS }
  ], 2, lastRow)) {
    return ContentService.createTextOutput(JSON.stringify({ ok: true, skipped: true, reason: 'Trùng Mã hồ sơ' }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var targetRow = lastRow + 1;
  if (targetRow < 2) targetRow = 2; // dữ liệu bắt đầu từ dòng 2

  // Ghi cột A (Mã HS), B (Ngày nhận), C (Người chuyển), D (Nội dung)
  sheet.getRange(targetRow, 1, 1, 4).setValues([[
    data.maHS || '', data.ngayNhan || '', data.nguoiChuyen || '', data.noiDung || ''
  ]]);

  return ContentService.createTextOutput(JSON.stringify({ ok: true, row: targetRow }))
    .setMimeType(ContentService.MimeType.JSON);
}
